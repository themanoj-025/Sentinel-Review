# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python source files
*.py text diff=python
*.pyw text
*.pyx text
*.pxd text
*.pxi text

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation
*.md text diff=markdown
*.rst text
*.txt text
*.json text
*.yaml text
*.yml text
*.toml text
*.cfg text
*.ini text
*.conf text

# Web
*.html text diff=html
*.css text
*.js text
*.ts text
*.jsx text
*.tsx text

# Docker
Dockerfile text
docker-compose.yml text
docker-compose.yaml text
Dockerfile.* text
.dockerignore text

# Git
.gitignore text
.gitattributes text
.gitmodules text

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.pem -diff
*.key -diff
*.cert -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff

# Binary files (never modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.gz binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Lock files
*.lock binary
