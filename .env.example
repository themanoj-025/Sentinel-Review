# ═══════════════════════════════════════════════════════════════════════════
# Sentinel Review — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables (app fails to start in production if unset):
#   DJANGO_SECRET_KEY, WEBHOOK_SECRET, GITHUB_APP_ID,
#   GITHUB_APP_PRIVATE_KEY_B64
#
# At least one LLM provider API key is needed for reviews:
#   ANTHROPIC_API_KEY or OPENAI_API_KEY
# ═══════════════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# REQUIRED in production — app fails to start if unset
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: set if behind a reverse proxy
# CORS_ALLOWED_ORIGINS=https://your-app.com,https://your-custom-domain.com

# ═══════════════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════════════
# Default: SQLite (file-based, no setup needed)
# For Docker Compose (PostgreSQL):
#   DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel_review
DATABASE_URL=sqlite:///backend/db.sqlite3

# ═══════════════════════════════════════════════════════════════════════
# Redis & Celery
# ═══════════════════════════════════════════════════════════════════════
# Default: local Redis (no auth)
# For Docker Compose:
#   CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Optional app version tag (shown in /health/ responses)
SENTINEL_VERSION=1.0.0

# ── GitHub App (Required) ─────────────────────────────────────────────
# Create a GitHub App at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Base64-encode your private key: base64 -w0 < path/to/private-key.pem
GITHUB_APP_PRIVATE_KEY_B64=

# ═══════════════════════════════════════════════════════════════════════
# Webhook
# ═══════════════════════════════════════════════════════════════════════
# REQUIRED in production — app fails to start if unset
# Must match the webhook secret configured in your GitHub App settings
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── LLM Provider (choose at least one) ────────────────────────────────
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ═══════════════════════════════════════════════════════════════════════
# Monitoring & Observability
# ═══════════════════════════════════════════════════════════════════════
# Set to True to expose Prometheus /metrics endpoint
METRICS_ENABLED=False

# Sentry (optional — uncomment to enable error tracking)
# SENTRY_DSN=https://your-dsn@sentry.io/your-project
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ═══════════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
JSON_LOG=False

# ═══════════════════════════════════════════════════════════════════════
# Flower (Celery dashboard)
# ═══════════════════════════════════════════════════════════════════════
FLOWER_USER=admin
FLOWER_PASSWORD=sentinel

# ═══════════════════════════════════════════════════════════════════════
# Notifications (Slack / Email) — optional
# ═══════════════════════════════════════════════════════════════════════
# Slack: incoming webhook URL for review-failure alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Email SMTP: requires all NOTIFICATION_EMAIL_* vars
# NOTIFICATION_EMAIL_HOST=smtp.example.com
# NOTIFICATION_EMAIL_PORT=587
# NOTIFICATION_EMAIL_USER=your-email-user
# NOTIFICATION_EMAIL_PASSWORD=your-email-password
# NOTIFICATION_EMAIL_FROM=sentinel-review@example.com
# NOTIFICATION_EMAIL_TO=your-team@example.com

# ═══════════════════════════════════════════════════════════════════════
# GitHub Actions Mode (no server needed) — optional
# ═══════════════════════════════════════════════════════════════════════
# These are set automatically by the GHA runtime; only needed for local testing
# GITHUB_TOKEN=
# GITHUB_EVENT_PATH=
# GITHUB_REPOSITORY=your-org/your-repo
