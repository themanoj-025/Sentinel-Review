# Sentinel Review — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# [REQUIRED] = Application will not start in production if unset
# [OPTIONAL] = Safe defaults exist; change to override
# [DEPLOY]   = Only needed when deploying (not for local dev with Docker)
# =============================================================================

# Django

# [REQUIRED in production] Django cryptographic signing key.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# [OPTIONAL] Debug mode. Default: True (safer for local dev). Set to False in production.
DJANGO_DEBUG=True

# [OPTIONAL] Comma-separated allowed hosts. Default: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# [OPTIONAL] Comma-separated CORS origins (not needed unless you have a separate frontend).
# CORS_ALLOWED_ORIGINS=https://your-app.com,https://your-custom-domain.com

# Database

# [OPTIONAL] Default: SQLite (file-based, no setup needed for local dev).
# For Docker Compose (PostgreSQL):
#   DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel_review
DATABASE_URL=sqlite:///backend/db.sqlite3

# Redis & Celery

# [OPTIONAL] Default: local Redis (no auth). Set if using a remote Redis or Docker.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# [OPTIONAL] Version tag shown in /health/ responses.
SENTINEL_VERSION=1.0.0

# GitHub App
# Create a GitHub App at: https://github.com/settings/apps
# These are [REQUIRED] for the app to review PRs.

# [REQUIRED] GitHub App ID (integer).
GITHUB_APP_ID=

# [OPTIONAL] GitHub App client ID (for OAuth flows, not used by webhook mode).
GITHUB_APP_CLIENT_ID=

# [OPTIONAL] GitHub App client secret (for OAuth flows, not used by webhook mode).
GITHUB_APP_CLIENT_SECRET=

# [REQUIRED] Base64-encoded GitHub App private key.
#   Generate: base64 -w0 < path/to/private-key.pem
GITHUB_APP_PRIVATE_KEY_B64=

# Webhook

# [REQUIRED in production] Must match the webhook secret configured in your GitHub App settings.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# LLM Provider
# At least one of ANTHROPIC_API_KEY or OPENAI_API_KEY is [REQUIRED] for reviews.

# [OPTIONAL] Select active provider: "anthropic" or "openai". Default: anthropic.
LLM_PROVIDER=anthropic

# [OPTIONAL] Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# [OPTIONAL] Anthropic model. Default: claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# [OPTIONAL] OpenAI API key.
OPENAI_API_KEY=sk-proj-REPLACE_ME

# [OPTIONAL] OpenAI model. Default: gpt-4o
OPENAI_MODEL=gpt-4o

# Observability

# [OPTIONAL] Set to True to expose Prometheus /metrics endpoint.
METRICS_ENABLED=False

# [OPTIONAL] Sentry DSN for error tracking. Uncomment to enable.
# SENTRY_DSN=https://your-dsn@sentry.io/your-project
# SENTRY_TRACES_SAMPLE_RATE=0.1

# [OPTIONAL] Log level. Default: DEBUG in dev, INFO in production.
LOG_LEVEL=INFO

# [OPTIONAL] Set to True to enable JSON-formatted logging (structured log output).
JSON_LOG=False

# Feature Flags (defaults)
# These are read from per-repo config in the database. The env vars below
# set system-level defaults used if no per-repo config exists.

# [OPTIONAL] Set to True for security-only review mode by default.
# FEATURE_SECURITY_ONLY=False

# Notifications (optional)

# Slack: incoming webhook URL for review-failure alerts. [OPTIONAL]
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Email SMTP: requires all NOTIFICATION_EMAIL_* vars (all [OPTIONAL]).
# NOTIFICATION_EMAIL_HOST=smtp.example.com
# NOTIFICATION_EMAIL_PORT=587
# NOTIFICATION_EMAIL_USER=your-email-user
# NOTIFICATION_EMAIL_PASSWORD=your-email-password
# NOTIFICATION_EMAIL_FROM=sentinel-review@example.com
# NOTIFICATION_EMAIL_TO=your-team@example.com

# GitHub Actions Mode (no server needed)
# These are set automatically by the GHA runtime; only needed for local testing.
# GITHUB_TOKEN=
# GITHUB_EVENT_PATH=
# GITHUB_REPOSITORY=your-org/your-repo

# Flower (Celery dashboard)
# [OPTIONAL] Basic auth credentials for the Flower dashboard.
FLOWER_USER=admin
FLOWER_PASSWORD=sentinel

# API Authentication
# [OPTIONAL] Bearer token for API endpoints. Leave blank for open access.
SENTINEL_API_KEY=

# Eval self-review demo (DO NOT enable outside the demo): the planted
# pickle.load demo fixture in scripts/eval_pkg/builders.py only runs when
# this is set to 1 AND the path is inside the repo cache dir.
# SENTINEL_EVAL_ALLOW_PICKLE_DEMO=1
