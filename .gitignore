# ==============================================================================
# sentinel-review - Security & Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS & ENVIRONMENT (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample
.secrets/
local_settings.py

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
credentials.json
client_secret*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.publishsettings

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ------------------------------------------------------------------------------
# 2. PYTHON RUNTIME, BUILDS & VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
*.manifest
*.spec

# Virtual environments
venv/
.venv/
env/
.env/
virtualenv/
.venv*/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. DJANGO & FRAMEWORK ASSETS
# ------------------------------------------------------------------------------
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
*.pot
*.mo

# ------------------------------------------------------------------------------
# 4. LOGS & DATABASES
# ------------------------------------------------------------------------------
logs/
*.log
*.dump
*.stackdump
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 5. TESTING, COVERAGE & PROFILING
# ------------------------------------------------------------------------------
htmlcov/
.coverage
.coverage.*
coverage.xml
.coverage.lcov
*.cover
coverage/
.cache/
coverage-html/
test-results/
reports/
.pytest_cache/
radar_balance.txt
*.prof
*.pstats

# ------------------------------------------------------------------------------
# 6. LINTERS & CODE ANALYSIS CACHES
# ------------------------------------------------------------------------------
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ------------------------------------------------------------------------------
# 7. IDE, EDITORS & OS ARTIFACTS
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
*.swp
*.swo
*.swn
*~
*.orig
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak

# ------------------------------------------------------------------------------
# 8. DOCKER & CELERY
# ------------------------------------------------------------------------------
docker-data/
docker-compose.override.yml
celerybeat-schedule*
celerybeat.pid

# ------------------------------------------------------------------------------
# 9. DATASETS & DOC BUILDS
# ------------------------------------------------------------------------------
data/codereviewer/
data/*.json
!data/.gitkeep
docs/_build/
docs/_static/
docs/build/

# ------------------------------------------------------------------------------
# 10. FRONTEND & NODE
# ------------------------------------------------------------------------------
node_modules/
package-lock.json
!frontend/package-lock.json
yarn.lock
*.js.map
assets/webpack/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================================
# KEEP: AI provenance & transparency files — must remain visible
# =====================================================================
!AI_DISCLOSURE.md
!AI_USAGE.md
!PROMPTS.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.github/copilot-instructions.md
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/settings.json
!docs/ai/
!docs/ai/**
!.ai/
!.ai/**
!ai-provenance.json
!.gitmessage
!CITATION.cff
